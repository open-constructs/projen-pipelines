exports[`GarbageCollectionStep should support jump role 1`] = `
{
  "env": {},
  "needs": [],
  "permissions": {
    "idToken": "write",
  },
  "steps": [
    {
      "name": "Assume Jump Role",
      "uses": "aws-actions/configure-aws-credentials@v5",
      "with": {
        "aws-region": "eu-central-1",
        "role-session-name": "GitHubAction",
        "role-skip-session-tagging": true,
        "role-to-assume": "arn:aws:iam::000000000000:role/JumpRole",
      },
    },
    {
      "name": "AWS Credentials",
      "uses": "aws-actions/configure-aws-credentials@v5",
      "with": {
        "aws-region": "eu-central-1",
        "role-chaining": true,
        "role-session-name": "GitHubAction",
        "role-skip-session-tagging": true,
        "role-to-assume": "arn:aws:iam::123456789012:role/GcRole",
      },
    },
    {
      "run": "npx projen gc:dev",
    },
  ],
}
`;

exports[`GitHubGarbageCollectionWorkflow should auto-detect pnpm for NodeProject with pnpm 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "pnpm exec projen".

name: cdk-gc
on:
  schedule:
    - cron: 0 3 * * 0
  workflow_dispatch: {}
jobs:
  gc-dev:
    name: GC - dev
    runs-on: ubuntu-latest
    permissions:
      contents: read
    concurrency:
      group: cdk-gc-dev
      cancelInProgress: false
    env: {}
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: "9"
      - name: Install dependencies
        run: pnpm exec projen install:ci
      - run: pnpm exec projen gc:dev 2>&1 | tee cdk-gc-output.txt
      - name: Write to job summary
        if: always()
        run: |-
          if [ -f cdk-gc-output.txt ]; then
            echo "## CDK Garbage Collection - dev" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            cat cdk-gc-output.txt >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
          fi
"
`;

