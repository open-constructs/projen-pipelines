// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`BashGarbageCollectionWorkflow should auto-detect pnpm and include pnpm install for NodeProject 1`] = `
"#!/bin/bash
set -euo pipefail

# CDK Garbage Collection Script

# Parse command line arguments
STAGE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --stage)
      STAGE="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--stage STAGE_NAME]"
      exit 1
      ;;
  esac
done

# Install dependencies if not already installed
if ! command -v cdk &> /dev/null; then
  echo "Installing dependencies..."
  npm install -g pnpm@9
  pnpm exec projen install:ci
fi

# Stage functions
# Stage: dev
run_stage_dev() {
  echo "========================================"
  echo "Running garbage collection for stage: dev"
  echo "========================================"
  pnpm exec projen gc:dev
}

# Main execution
FAILED_STAGES=()

if [[ -n "$STAGE" ]]; then
  # Run specific stage
  case "$STAGE" in
    dev)
      run_stage_dev || FAILED_STAGES+=("dev")
      ;;
    *)
      echo "Unknown stage: $STAGE"
      echo "Available stages:"
      echo "  - dev"
      exit 1
      ;;
  esac
else
  # Run all stages
  run_stage_dev || FAILED_STAGES+=("dev")
fi

# Summary
echo ""
echo "========================================"
echo "CDK GARBAGE COLLECTION COMPLETE"
echo "========================================"

if [[ \${#FAILED_STAGES[@]} -gt 0 ]]; then
  echo "Failed stages:"
  printf '  - %s\\n' "\${FAILED_STAGES[@]}"
  exit 1
else
  echo "All stages completed successfully"
fi"
`;

exports[`BashGarbageCollectionWorkflow should create bash script 1`] = `
"#!/bin/bash
set -euo pipefail

# CDK Garbage Collection Script

# Parse command line arguments
STAGE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --stage)
      STAGE="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--stage STAGE_NAME]"
      exit 1
      ;;
  esac
done

# Install dependencies if not already installed
if ! command -v cdk &> /dev/null; then
  echo "Installing dependencies..."
  npx projen install:ci
fi

# Stage functions
# Stage: dev
run_stage_dev() {
  echo "========================================"
  echo "Running garbage collection for stage: dev"
  echo "========================================"
  echo "Login to AWS using role arn:aws:iam::123456789012:role/GcRole for region eu-central-1"
  npx projen gc:dev
}

# Stage: prod
run_stage_prod() {
  echo "========================================"
  echo "Running garbage collection for stage: prod"
  echo "========================================"
  npx projen gc:prod
}

# Main execution
FAILED_STAGES=()

if [[ -n "$STAGE" ]]; then
  # Run specific stage
  case "$STAGE" in
    dev)
      run_stage_dev || FAILED_STAGES+=("dev")
      ;;
    prod)
      run_stage_prod || FAILED_STAGES+=("prod")
      ;;
    *)
      echo "Unknown stage: $STAGE"
      echo "Available stages:"
      echo "  - dev"
      echo "  - prod"
      exit 1
      ;;
  esac
else
  # Run all stages
  run_stage_dev || FAILED_STAGES+=("dev")
  run_stage_prod || FAILED_STAGES+=("prod")
fi

# Summary
echo ""
echo "========================================"
echo "CDK GARBAGE COLLECTION COMPLETE"
echo "========================================"

if [[ \${#FAILED_STAGES[@]} -gt 0 ]]; then
  echo "Failed stages:"
  printf '  - %s\\n' "\${FAILED_STAGES[@]}"
  exit 1
else
  echo "All stages completed successfully"
fi"
`;

