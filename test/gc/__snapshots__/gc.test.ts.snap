exports[`GitLabGarbageCollectionWorkflow should add runner tags when specified 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

stages:
  - gc
.cdk-gc:
  stage: gc
  tags:
    - docker
    - aws
  image:
    name: node:20
  id_tokens:
    AWS_TOKEN:
      aud: https://sts.amazonaws.com
  only:
    refs:
      - schedules
    variables:
      - $CI_PIPELINE_SOURCE == "schedule"
      - $CDK_GC == "true"
  before_script:
    - apt-get update && apt-get install -y python3 python3-pip
    - pip3 install awscli
    - npx projen install:ci
gc:dev:
  extends:
    - .cdk-gc
  variables: {}
  script:
    - npx projen gc:dev
"
`;

exports[`GitLabGarbageCollectionWorkflow should create GitLab pipeline 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

stages:
  - gc
.cdk-gc:
  stage: gc
  tags: []
  image:
    name: node:20
  id_tokens:
    AWS_TOKEN:
      aud: https://sts.amazonaws.com
  only:
    refs:
      - schedules
    variables:
      - $CI_PIPELINE_SOURCE == "schedule"
      - $CDK_GC == "true"
  before_script:
    - apt-get update && apt-get install -y python3 python3-pip
    - pip3 install awscli
    - npx projen install:ci
gc:dev:
  extends:
    - .cdk-gc
  variables:
    AWS_REGION: eu-central-1
  script:
    - export $(printf "AWS_ACCESS_KEY_ID=%s AWS_SECRET_ACCESS_KEY=%s AWS_SESSION_TOKEN=%s" $(aws sts assume-role-with-web-identity --role-arn "arn:aws:iam::123456789012:role/GcRole" --role-session-name "GitLabRunner-\${CI_PROJECT_ID}-\${CI_PIPELINE_ID}}" --web-identity-token \${AWS_TOKEN} --duration-seconds 3600 --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' --output text))
    - npx projen gc:dev
"
`;

