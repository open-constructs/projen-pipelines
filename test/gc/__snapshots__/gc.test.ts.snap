      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Enable corepack
        run: corepack enable
      - name: Install dependencies
        run: yarn projen install:ci
      - run: yarn projen gc:dev 2>&1 | tee cdk-gc-output.txt
      - name: Write to job summary
        if: always()
        run: |-
          if [ -f cdk-gc-output.txt ]; then
            echo "## CDK Garbage Collection - dev" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            cat cdk-gc-output.txt >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
          fi
"
`;

exports[`GitHubGarbageCollectionWorkflow should create GitHub workflow with basic configuration 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: cdk-gc
on:
  schedule:
    - cron: 0 3 * * 0
  workflow_dispatch: {}
jobs:
  gc-dev:
    name: GC - dev
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    concurrency:
      group: cdk-gc-dev
      cancelInProgress: false
    env: {}
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Install dependencies
        run: npx projen install:ci
      - name: AWS Credentials
        uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: arn:aws:iam::123456789012:role/GcRole
          role-session-name: GitHubAction
          aws-region: eu-central-1
      - run: npx projen gc:dev 2>&1 | tee cdk-gc-output.txt
      - name: Write to job summary
        if: always()
        run: |-
          if [ -f cdk-gc-output.txt ]; then
            echo "## CDK Garbage Collection - dev" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            cat cdk-gc-output.txt >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
          fi
  gc-prod:
    name: GC - prod
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    concurrency:
      group: cdk-gc-prod
      cancelInProgress: false
    env: {}
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Install dependencies
        run: npx projen install:ci
      - name: AWS Credentials
        uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: arn:aws:iam::987654321098:role/GcRole
          role-session-name: GitHubAction
          aws-region: eu-central-1
      - run: npx projen gc:prod 2>&1 | tee cdk-gc-output.txt
      - name: Write to job summary
        if: always()
        run: |-
          if [ -f cdk-gc-output.txt ]; then
            echo "## CDK Garbage Collection - prod" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            cat cdk-gc-output.txt >> $GITHUB_STEP_SUMMARY
            echo "\\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
          fi
"
`;

