// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`remediation workflows Bash: emits run_remediation and run_verify functions with --yes support 1`] = `
"#!/bin/bash
set -euo pipefail

# Drift Detection Script

# Parse command line arguments
STAGE=""
AUTO_YES="false"
while [[ $# -gt 0 ]]; do
  case $1 in
    --stage)
      STAGE="$2"
      shift 2
      ;;
    --yes)
      AUTO_YES="true"
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--stage STAGE_NAME] [--yes]"
      exit 1
      ;;
  esac
done

# Install dependencies if not already installed
if ! command -v ts-node &> /dev/null; then
  echo "Installing dependencies..."
  npx projen install:ci
fi

# Function to run drift detection for a stage
run_drift_detection() {
  local stage_name=$1
  local region=$2
  local role_arn=$3
  local stacks=$4
  local fail_on_drift=$5
  local error_handlers=$6
  local env_vars=$7

  echo "========================================"
  echo "Running drift detection for stage: $stage_name"
  echo "========================================"

  # Set environment variables
  export AWS_DEFAULT_REGION="$region"
  export DRIFT_DETECTION_OUTPUT="drift-results-$stage_name.json"
  eval "$env_vars"

  # Assume role if provided
  if [[ -n "$role_arn" ]]; then
    echo "Assuming role: $role_arn"
    CREDS=$(aws sts assume-role \\
      --role-arn "$role_arn" \\
      --role-session-name "drift-detection-$stage_name" \\
      --query "Credentials.[AccessKeyId,SecretAccessKey,SessionToken]" \\
      --output text)
    export AWS_ACCESS_KEY_ID=$(echo $CREDS | cut -d' ' -f1)
    export AWS_SECRET_ACCESS_KEY=$(echo $CREDS | cut -d' ' -f2)
    export AWS_SESSION_TOKEN=$(echo $CREDS | cut -d' ' -f3)
  fi

  # Build command
  local cmd="npx ts-node src/drift/detect-drift.ts --region $region"
  
  if [[ -n "$stacks" ]]; then
    cmd="$cmd --stacks $stacks"
  fi
  
  if [[ "$fail_on_drift" == "false" ]]; then
    cmd="$cmd --no-fail-on-drift"
  fi
  
  if [[ -n "$error_handlers" ]]; then
    cmd="$cmd --error-handlers '$error_handlers'"
  fi

  # Run drift detection
  echo "Running: $cmd"
  eval "$cmd" || {
    local exit_code=$?
    echo "Drift detection failed with exit code: $exit_code"
    if [[ "$fail_on_drift" == "true" ]]; then
      return $exit_code
    fi
  }
}

# Stage configurations
# Stage: prod
run_stage_prod() {
  export AWS_DEFAULT_REGION="us-east-1"
  export DRIFT_DETECTION_OUTPUT="drift-results-prod.json"
  export AWS_REGION="us-east-1"
  export STAGE_NAME="prod"
  detect-drift --region us-east-1
}

# Remediation for stage: prod (policy: manual)
run_remediation_prod() {
  if [[ "$AUTO_YES" != "true" ]]; then
    read -r -p "Revert drifted stacks in prod? [y/N] " reply
    if [[ ! "$reply" =~ ^[Yy]$ ]]; then
      echo "Skipping remediation."
      return 0
    fi
  fi
  export AWS_DEFAULT_REGION="us-east-1"
  export AWS_REGION="us-east-1"
  export STAGE_NAME="prod"
  revert-drift --region us-east-1 --results drift-results-prod.json --yes
}

# Verification for stage: prod
run_verify_prod() {
  export AWS_DEFAULT_REGION="us-east-1"
  export DRIFT_DETECTION_OUTPUT="drift-verify-prod.json"
  export AWS_REGION="us-east-1"
  export STAGE_NAME="prod"
  detect-drift --region us-east-1
}

# Main execution
FAILED_STAGES=()

if [[ -n "$STAGE" ]]; then
  # Run specific stage
  case "$STAGE" in
    prod)
      run_stage_prod || FAILED_STAGES+=("prod")
      run_remediation_prod || FAILED_STAGES+=("prod-remediation")
      run_verify_prod || FAILED_STAGES+=("prod-verify")
      ;;
    *)
      echo "Unknown stage: $STAGE"
      echo "Available stages:"
      echo "  - prod"
      exit 1
      ;;
  esac
else
  # Run all stages
  run_stage_prod || FAILED_STAGES+=("prod")
  run_remediation_prod || FAILED_STAGES+=("prod-remediation")
  run_verify_prod || FAILED_STAGES+=("prod-verify")
fi

# Summary
echo ""
echo "========================================"
echo "DRIFT DETECTION COMPLETE"
echo "========================================"

if [[ \${#FAILED_STAGES[@]} -gt 0 ]]; then
  echo "Failed stages:"
  printf '  - %s\\n' "\${FAILED_STAGES[@]}"
  exit 1
else
  echo "All stages completed successfully"
fi"
`;

exports[`remediation workflows GitHub: adds gated remediate + verify jobs for a manual stage 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: drift-detection
on:
  schedule:
    - cron: 0 0 * * *
  workflow_dispatch:
    inputs:
      stage:
        description: Stage to check for drift (leave empty for all)
        required: false
        type: choice
        options:
          - prod
jobs:
  drift-prod:
    name: Drift Detection - prod
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      AWS_DEFAULT_REGION: us-east-1
      DRIFT_DETECTION_OUTPUT: drift-results-prod.json
      AWS_REGION: us-east-1
      STAGE_NAME: prod
    if: \${{ github.event_name == 'schedule' || github.event.inputs.stage == '' || github.event.inputs.stage == 'prod' }}
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Install dependencies
        id: install_dependencies
        run: npx projen install:ci
      - id: auto_713bcdc7
        run: detect-drift --region us-east-1
      - name: Upload results
        id: upload_results
        uses: actions/upload-artifact@v7
        with:
          name: drift-results-prod
          path: drift-results-prod.json
  remediate-prod:
    name: Drift Remediation - prod
    needs: drift-prod
    runs-on: ubuntu-latest
    permissions:
      contents: read
    environment: drift-remediation-prod
    env:
      AWS_DEFAULT_REGION: us-east-1
      AWS_REGION: us-east-1
      STAGE_NAME: prod
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Install dependencies
        id: install_dependencies
        run: npx projen install:ci
      - name: Download drift results
        id: download_drift_results
        uses: actions/download-artifact@v8
        with:
          name: drift-results-prod
      - id: auto_7a0a946a
        run: revert-drift --region us-east-1 --results drift-results-prod.json --yes
  verify-prod:
    name: Drift Verification - prod
    needs: remediate-prod
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      AWS_DEFAULT_REGION: us-east-1
      DRIFT_DETECTION_OUTPUT: drift-verify-prod.json
      AWS_REGION: us-east-1
      STAGE_NAME: prod
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v6
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v6
        with:
          node-version: "20"
      - name: Install dependencies
        id: install_dependencies
        run: npx projen install:ci
      - id: auto_713bcdc7
        run: detect-drift --region us-east-1
  drift-summary:
    name: Drift Detection Summary
    needs: drift-prod
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Download all artifacts
        id: download_all_artifacts
        uses: actions/download-artifact@v8
        with:
          path: drift-results
      - name: Generate summary
        id: generate_summary
        run: |
          
          #!/bin/bash
          echo "## Drift Detection Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          total_stacks=0
          total_drifted=0
          total_errors=0

          for file in drift-results-*.json; do
            if [[ -f "$file" ]]; then
              stage=$(basename $(dirname "$file"))
              echo "### Stage: $stage" >> $GITHUB_STEP_SUMMARY
              
              # Parse JSON and generate summary
              jq -r '
                . as $results |
                "- Total stacks: " + ($results | length | tostring) + "\\n" +
                "- Drifted: " + ([$results[] | select(.driftStatus == "DRIFTED")] | length | tostring) + "\\n" +
                "- Errors: " + ([$results[] | select(.error)] | length | tostring) + "\\n" +
                ([$results[] | select(.driftStatus == "DRIFTED")] | 
                  if length > 0 then
                    "\\n**Drifted stacks:**\\n" + 
                    (map("  - " + .stackName + " (" + ((.driftedResources // []) | length | tostring) + " resources)") | join("\\n"))
                  else "" end)
              ' "$file" >> $GITHUB_STEP_SUMMARY
              
              echo "" >> $GITHUB_STEP_SUMMARY
              
              # Count totals
              total_stacks=$((total_stacks + $(jq 'length' "$file")))
              total_drifted=$((total_drifted + $(jq '[.[] | select(.driftStatus == "DRIFTED")] | length' "$file")))
              total_errors=$((total_errors + $(jq '[.[] | select(.error)] | length' "$file")))
            fi
          done

          echo "### Overall Summary" >> $GITHUB_STEP_SUMMARY
          echo "- Total stacks checked: $total_stacks" >> $GITHUB_STEP_SUMMARY
          echo "- Total drifted stacks: $total_drifted" >> $GITHUB_STEP_SUMMARY
          echo "- Total errors: $total_errors" >> $GITHUB_STEP_SUMMARY

          if [[ $total_drifted -gt 0 ]]; then
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "⚠️ **Action required:** Drift detected in $total_drifted stacks" >> $GITHUB_STEP_SUMMARY
          fi
"
`;

exports[`remediation workflows GitLab: adds remediation and verify stages when enabled 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

stages:
  - drift-detection
  - summary
  - remediation
  - verify
.drift-detection:
  stage: drift-detection
  tags: []
  image:
    name: node:18
  id_tokens:
    AWS_TOKEN:
      aud: https://sts.amazonaws.com
  only:
    refs:
      - schedules
    variables:
      - $CI_PIPELINE_SOURCE == "schedule"
      - $DRIFT_DETECTION == "true"
  before_script:
    - apt-get update && apt-get install -y python3 python3-pip
    - pip3 install awscli
    - npx projen install:ci
  artifacts:
    paths:
      - drift-results-*.json
    expire_in: 1 week
    when: always
drift:dev:
  extends:
    - .drift-detection
  variables:
    AWS_DEFAULT_REGION: us-east-1
    DRIFT_DETECTION_OUTPUT: drift-results-dev.json
    AWS_REGION: us-east-1
    STAGE_NAME: dev
  script:
    - detect-drift --region us-east-1
  allow_failure: true
remediate:dev:
  stage: remediation
  tags: []
  image:
    name: node:18
  needs:
    - drift:dev
  variables:
    AWS_DEFAULT_REGION: us-east-1
    AWS_REGION: us-east-1
    STAGE_NAME: dev
  script:
    - revert-drift --region us-east-1 --results drift-results-dev.json --yes
  artifacts:
    reports:
      dotenv:
        - drift-dev.env
    paths:
      - drift-results-dev.json
    expire_in: 1 week
    when: always
  when: on_success
verify:dev:
  stage: verify
  tags: []
  image:
    name: node:18
  needs:
    - remediate:dev
  variables:
    AWS_DEFAULT_REGION: us-east-1
    DRIFT_DETECTION_OUTPUT: drift-verify-dev.json
    AWS_REGION: us-east-1
    STAGE_NAME: dev
  script:
    - detect-drift --region us-east-1
  when: on_success
drift:summary:
  stage: summary
  tags: []
  needs:
    - drift:dev
  only:
    refs:
      - schedules
    variables:
      - $CI_PIPELINE_SOURCE == "schedule"
      - $DRIFT_DETECTION == "true"
  script:
    - echo "## Drift Detection Summary"
    - echo ""
    - |
      
      total_stacks=0
      total_drifted=0
      total_errors=0

      for file in drift-results-*.json; do
        if [[ -f "$file" ]]; then
          stage=$(echo $file | sed 's/drift-results-//;s/.json//')
          echo "### Stage: $stage"
          
          # Count results
          stacks=$(jq 'length' "$file")
          drifted=$(jq '[.[] | select(.driftStatus == "DRIFTED")] | length' "$file")
          errors=$(jq '[.[] | select(.error)] | length' "$file")
          
          echo "- Total stacks: $stacks"
          echo "- Drifted: $drifted"
          echo "- Errors: $errors"
          
          # Show drifted stacks
          if [[ $drifted -gt 0 ]]; then
            echo ""
            echo "**Drifted stacks:**"
            jq -r '.[] | select(.driftStatus == "DRIFTED") | "  - " + .stackName + " (" + ((.driftedResources // []) | length | tostring) + " resources)"' "$file"
          fi
          
          echo ""
          
          # Accumulate totals
          total_stacks=$((total_stacks + stacks))
          total_drifted=$((total_drifted + drifted))
          total_errors=$((total_errors + errors))
        fi
      done

      echo "### Overall Summary"
      echo "- Total stacks checked: $total_stacks"
      echo "- Total drifted stacks: $total_drifted"
      echo "- Total errors: $total_errors"

      if [[ $total_drifted -gt 0 ]]; then
        echo ""
        echo "⚠️ **Action required:** Drift detected in $total_drifted stacks"
        
        # Send notification if webhook is configured
        if [[ -n "$DRIFT_NOTIFICATION_WEBHOOK" ]]; then
          curl -X POST "$DRIFT_NOTIFICATION_WEBHOOK" \\
            -H "Content-Type: application/json" \\
            -d "{\\"text\\": \\"Drift detected in $total_drifted stacks. Check pipeline $CI_PIPELINE_URL for details.\\"}" || true
        fi
      fi
  when: always
"
`;
